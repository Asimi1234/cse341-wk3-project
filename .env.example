# Copy this file to .env and fill in your own values.
# Your MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/watchlist?retryWrites=true&w=majority

# Port the server listens on (optional — defaults to 3000)
PORT=3000

# Secret used to sign the session cookie (any long random string)
SESSION_SECRET=<a-long-random-string>

# GitHub OAuth app credentials (github.com > Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>
# Local: http://localhost:3000/auth/github/callback
# Production: https://cse341-wk3-project-ptd0.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
